# Copy to .env and adjust. All values optional; defaults shown.

# SQLAlchemy URL. SQLite for v0.1; a postgresql+psycopg:// URL is the intended migration path.
BDO_DATABASE_URL=sqlite:///data/bdo.sqlite

# Root for raw/, processed/, manual/, exports/
BDO_DATA_DIR=data

# Directory holding sources.yaml and settings.yaml
BDO_CONFIG_DIR=config

# DEBUG | INFO | WARNING
BDO_LOG_LEVEL=INFO

# Map base layer: carto-positron | open-street-map | white-bg (white-bg needs no internet)
BDO_MAP_STYLE=carto-positron

# true | false — public read-only alpha mode (Streamlit Community Cloud). When true: the UI hides
# admin/diagnostic controls and internal file paths, and ingestion / field-observation import
# refuse to run. Leave false (or unset) for local research/developer use.
PUBLIC_DEPLOYMENT=false
