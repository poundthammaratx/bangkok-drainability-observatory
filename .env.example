# Copy to .env and adjust. All values optional; defaults shown.

# SQLAlchemy URL. SQLite for local dev/tests; postgresql+psycopg://user:pass@host/db for the
# persistent production archive (v0.3 — see docs/DATABASE_DEPLOYMENT.md). Never commit a real
# value here or in .env — this file is only an example.
BDO_DATABASE_URL=sqlite:///data/bdo.sqlite

# true | false — whether a persistent archive is expected to be reachable at BDO_DATABASE_URL.
# When false, archive-dependent UI (Live Situation trends, archive-backed Event Archive queries)
# degrades to live-read-through-only instead of attempting a connection. See
# docs/PERSISTENT_ARCHIVE.md.
BDO_ARCHIVE_ENABLED=false

# VIEWER | COLLECTOR | DEVELOPMENT (see docs/DATABASE_DEPLOYMENT.md). Unset resolves to VIEWER
# when PUBLIC_DEPLOYMENT=true, else DEVELOPMENT — matching v0.1/v0.2 behaviour unchanged.
# VIEWER and COLLECTOR are deployment-time choices; do not set VIEWER on a machine that is meant
# to run `bdo collect`.
# BDO_RUNTIME_ROLE=DEVELOPMENT

# true | false — explicit override allowing BDO_RUNTIME_ROLE=COLLECTOR with BDO_ARCHIVE_ENABLED=true
# to run against a SQLite BDO_DATABASE_URL. Without it, that combination fails fast instead of
# silently collecting into a local file when a production Postgres URL was meant to be set — see
# docs/DATABASE_DEPLOYMENT.md. Only ever set true for deliberate local collector testing.
BDO_ALLOW_SQLITE_COLLECTOR=false

# Root for raw/, processed/, manual/, exports/
BDO_DATA_DIR=data

# Directory holding sources.yaml and settings.yaml
BDO_CONFIG_DIR=config

# DEBUG | INFO | WARNING
BDO_LOG_LEVEL=INFO

# Map base layer: carto-positron | open-street-map | white-bg (white-bg needs no internet)
BDO_MAP_STYLE=carto-positron

# true | false — public read-only alpha mode (Streamlit Community Cloud). When true: the UI hides
# admin/diagnostic controls and internal file paths, and ingestion / field-observation import
# refuse to run. Leave false (or unset) for local research/developer use.
PUBLIC_DEPLOYMENT=false
